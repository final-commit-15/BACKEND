# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://backend:backendpass@postgres:5432/agentforge

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change_this_in_production_please
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# External Services (for later)
AGENTS_SERVICE_URL=http://agentforge-agents:8000
AI_SERVICES_URL=http://agentforge-ai-services:8000
INTEGRATIONS_SERVICE_URL=http://agentforge-integrations:8000

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Celery Broker
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2