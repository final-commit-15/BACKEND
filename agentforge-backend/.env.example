# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Supabase Configuration (Primary)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# Database - Supabase PostgreSQL
# Get this from Supabase project settings: https://supabase.com/dashboard/project/_/settings/database
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Or with asyncpg: postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (Legacy - Supabase handles JWT now, but kept for backward compatibility)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_ROTATION=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
CORS_EXPOSE_HEADERS=["*"]
CORS_MAX_AGE=600

# Security
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=100/minute

# File upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=["image/jpeg", "image/png", "image/gif", "application/pdf", "text/plain"]

# External Services
AGENTS_SERVICE_URL=http://host.docker.internal:8001
AI_SERVICES_URL=http://agentforge-ai-services:8000
INTEGRATIONS_SERVICE_URL=http://agentforge-integrations:8000

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Celery Broker
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Monitoring
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Logging
STRUCTURED_LOGGING=true
LOG_SENSITIVE_FIELDS=["password", "token", "secret", "authorization", "cookie", "api_key", "refresh_token"]

# Supabase Storage Buckets
STORAGE_BUCKET_AGENT_ASSETS=agent-assets
STORAGE_BUCKET_WORKSPACE_FILES=workspace-files
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_DOCUMENTS=documents

# Backend URL for webhooks
BACKEND_URL=http://localhost:8000